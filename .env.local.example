# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Postgres connection strings (e.g. from Neon: https://neon.tech).
# DATABASE_URL: the pooled connection, used by the app at runtime.
# DIRECT_URL: the direct (non-pooled) connection, used only by Prisma Migrate.
# On Neon, DIRECT_URL is the same host as DATABASE_URL with "-pooler" removed.
# connect_timeout=15 gives Neon's free-tier autosuspended compute time to wake up
# instead of the first request after idle failing outright (P1001 "Can't reach
# database server").
# pgbouncer=true (DATABASE_URL only — never on DIRECT_URL) tells Prisma it's
# talking to an external transaction-mode pooler (Neon's pooled endpoint really
# is PgBouncer under the hood), disabling prepared-statement caching that's
# incompatible with it. Without this, Prisma's connection pool can exhaust
# itself under normal load ("Timed out fetching a new connection from the
# connection pool", code P2024) — every write-heavy endpoint (submissions,
# admin CRUD) is especially exposed since each does several sequential queries.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"

# Change these before running a real session; the values below are the
# insecure defaults used when the vars are unset.
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="complex_password_at_least_32_characters_long"

# Set to "true" only if the app is served over HTTPS.
ADMIN_SESSION_SECURE_COOKIE="false"
