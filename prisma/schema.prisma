// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app at runtime
  directUrl = env("DIRECT_URL")   // direct connection, used only by Prisma Migrate
}

model ChallengeLock {
  id        String @id
  locked    Boolean
}

// Durable mirror of the socket server's in-memory timer state, written by the
// admin dashboard whenever a timer starts/pauses/resumes/resets. The socket
// server stays in-memory-only (fast, for the live countdown broadcast) — this
// table exists purely so submit-challenge/submit-flag (plain REST routes, a
// separate process from the socket server) can authoritatively check "has this
// challenge's timer actually expired" before accepting a submission.
model ChallengeTimer {
  id        String   @id // challengeId
  startTime DateTime
  duration  Int      // ms
  isRunning Boolean  @default(false)
  isPaused  Boolean  @default(false)
}

model LeaderboardUser {
  id        String @id @default(uuid())
  name      String @unique
  avatar    String
  score     Int
}

model ChallengeSubmission {
  id        String   @id @default(uuid())
  userName  String
  challengeId String
  selectedLines String // stores JSON array as string
  correct   Boolean
  createdAt DateTime @default(now())
}

model FlagSubmission {
  id          String   @id @default(uuid())
  userName    String
  challengeId String
  flag        String
  correct     Boolean
  createdAt   DateTime @default(now())
}

model Challenge {
  id                 String  @id
  title              String
  description        String
  code               String
  vulnerableLines    String // JSON array of line numbers, e.g. "[3,9]"
  difficulty         String
  hints              String? // JSON array of strings
  explanations       String // JSON object of { [lineNumber]: string }
  flag               String?
  labUrl             String?
  maxSelectableLines Int?
  fixedCode          String? // the patched/secure version, revealed once lab time is up
  order              Int     @default(0) // defines the lab sequence; lower shows first
}
